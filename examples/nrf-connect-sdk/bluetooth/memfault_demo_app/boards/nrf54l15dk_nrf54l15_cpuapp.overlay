/* As of NCS v3.4.0, this board's flash layout is defined natively in
 * devicetree (upstream Zephyr board support) rather than via the Partition
 * Manager, and it leaves no spare space for a Memfault coredump partition.
 * Carve one out of the tail of storage_partition instead.
 */
&cpuapp_rram {
	partitions {
		/* Nordic's native partition layout omits this compatible, but the
		 * Memfault SDK's DT_HAS_FIXED_PARTITION_LABEL() lookup requires it.
		 */
		compatible = "fixed-partitions";

		storage_partition: partition@174000 {
			reg = <0x174000 0x8000>;
		};

		memfault_coredump_partition: partition@17c000 {
			compatible = "zephyr,mapped-partition";
			label = "memfault_coredump_partition";
			reg = <0x17c000 0x1000>;
		};
	};
};
